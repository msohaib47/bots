# Schwab API Configuration (OAuth)
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_ACCESS_TOKEN=your_access_token_here
SCHWAB_REFRESH_TOKEN=your_refresh_token_here
SCHWAB_ACCOUNT_NUMBER=your_account_number
SCHWAB_BASE_URL=https://api.schwabapi.com

# Stop-Loss Configuration
STOPLOSS_INITIAL_MARGIN_PCT=0.25
STOPLOSS_INITIAL_MARGIN_DOLLAR=10

# Bot Configuration
DRY_RUN=true
RUN_ONCE=false
STATUS_ONLY=false
LOG_LEVEL=info

# State Management
STATE_FILE=./guard_state.json

# Notifications
NOTIFY_TOPIC=sohaib-trading-2026
