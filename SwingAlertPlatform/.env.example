# Database
DATABASE_URL=postgresql+psycopg://swingalert:swingalert@db:5432/swingalert

# Alpaca market data (read-only usage — this platform never places orders)
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# NTFY (public ntfy.sh — separate topic namespace from the other bots)
NTFY_BASE_URL=https://ntfy.sh
NTFY_GLOBAL_TOPIC=swing-alerts-global
NTFY_USER_TOPIC_PREFIX=swing-alerts-

# Default watchlist seeded for the first user (comma-separated)
DEFAULT_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# Alert behavior
ALERT_COOLDOWN_MINUTES=240

# Score -> classification thresholds
SCORE_STRONG_BUY=8
SCORE_BUY=3
SCORE_SELL=-3
SCORE_STRONG_SELL=-8

# Scheduler
BAR_SYNC_INTERVAL_MINUTES=5

LOG_LEVEL=INFO
