[Unit]
Description=DayTradingBotV2 Execution service, Start-at-200 account
After=network-online.target daysignalservice.service daysizing-start200.service
Wants=network-online.target
Requires=daysignalservice.service

[Service]
Type=simple
User=claude
ExecStart=/home/claude/dayexec-start200.sh
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/claude/bots-live/logs/dayexec-start200.stdout.log
StandardError=append:/home/claude/bots-live/logs/dayexec-start200.stdout.log

[Install]
WantedBy=multi-user.target
