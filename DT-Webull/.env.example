# DT-Webull — copy to .env and fill in real credentials before running.
# Do NOT commit a real .env (see repo .gitignore).

# ── Endpoints ──────────────────────────────────────────────────────────────
# Sandbox by default -- deliberately, so a misconfigured .env can't touch a
# real account. Switch to https://api.webull.com once ready for real trading.
WEBULL_BASE_URL=https://api.sandbox.webull.com
WEBULL_REGION_ID=us

# ── Accounts (multi-account: add as many WEBULL_<NAME>_* blocks as needed) ──
WEBULL_ACCOUNTS=main

WEBULL_MAIN_APP_KEY=REPLACE_WITH_REAL_APP_KEY
WEBULL_MAIN_APP_SECRET=REPLACE_WITH_REAL_APP_SECRET
WEBULL_MAIN_ACCOUNT_ID=REPLACE_WITH_REAL_ACCOUNT_ID

# Example second account -- uncomment and fill in to trade a 2nd account from
# the same cron tick (each gets its own positions_<name>.json/trades_<name>.csv):
# WEBULL_ACCOUNTS=main,secondary
# WEBULL_SECONDARY_APP_KEY=REPLACE_WITH_REAL_APP_KEY
# WEBULL_SECONDARY_APP_SECRET=REPLACE_WITH_REAL_APP_SECRET
# WEBULL_SECONDARY_ACCOUNT_ID=REPLACE_WITH_REAL_ACCOUNT_ID

# ── Trading rules (same defaults as DayTradingBot's .env) ───────────────────
MAX_CONTRACTS=4
STOP_LOSS_PCT=0.30
PROFIT_TRAIL_TRIGGER=0.30
TRAIL_WIGGLE=0.15
NO_NEW_ENTRY_TIME=12:00
FORCE_CLOSE_TIME=15:50
