# DT-Stocks — copy to .env and fill in real credentials before running.
ALPACA_API_KEY=REPLACE_WITH_REAL_KEY
ALPACA_SECRET_KEY=REPLACE_WITH_REAL_SECRET

ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Tuned via backtest sweep 2026-09-08 -- see DT-Stocks/.env's comment or README.md
STOP_LOSS_PCT=0.015
PROFIT_TRAIL_TRIGGER=0.03
TRAIL_WIGGLE=0.015
NO_NEW_ENTRY_TIME=12:00
FORCE_CLOSE_TIME=15:50

MAX_POSITION_VALUE=2000
MAX_OPEN_EXPOSURE=8000
CASH_PER_TRADE_PCT=0.20
