# eBay Developer Program application credentials (Browse API).
# Sign up (free) at https://developer.ebay.com, create a keyset under
# "Application Keys" (Production), and use the Client ID / Client Secret
# from there. This only needs the client-credentials grant — no user login,
# no partner approval required (unlike sold/completed listings).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace to search (default: US)
EBAY_MARKETPLACE_ID=EBAY_US

# Optional overrides
# EBAY_NEW_DB_PATH=/home/claude/data/ebay_new_listings.db
# EBAY_NEW_CONFIG_FILE=./configs.json
# EBAY_NEW_LIMIT=50
